---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveImage } from '../../lib/image-registry';

interface Props {
  title?: string;
  items: Array<{
    label: string;
    description?: string;
    image?: string;      // optional — text-only items render without images
    imageAlt?: string;
  }>;
}

const { title, items } = Astro.props;
const locale = Astro.currentLocale ?? 'de';
const isDE = locale.startsWith('de');

// Resolve images for each item upfront; skip items without an image path
const resolvedItems = items.map((item) => ({
  ...item,
  hasImage: !!item.image,
  optimizedImage: item.image ? (resolveImage(item.image) as ImageMetadata | null) : null,
}));

// Only items with images are shown in the desktop hover panel
const itemsWithImages = resolvedItems.filter((item) => item.hasImage);
const hasAnyImage = itemsWithImages.length > 0;

// Mobile image dimensions (h-48 aspect ratio ~ 16:7.5)
const MOBILE_WIDTH = 400;
const MOBILE_HEIGHT = 192;

// Desktop hover image dimensions (square aspect)
const DESKTOP_WIDTH = 600;
const DESKTOP_HEIGHT = 600;
---

<section class="bg-eos-base py-16 lg:py-24" data-interactive-list>
  <!-- Optional title -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {title && <h2 class="text-2xl lg:text-3xl font-bold text-eos-accent uppercase mb-12">{title}</h2>}

    <div class="relative flex gap-12 lg:gap-20 items-start">

      <!-- LEFT: List of items -->
      <ul class="flex-1 divide-y divide-eos-subtle" role="list">
        {items.map((item, i) => (
          <li
            class="interactive-list-item py-6 lg:py-8 cursor-default group transition-colors duration-300 hover:bg-gradient-to-r hover:from-eos-accent hover:to-eos-accent/80 px-4 -mx-4 rounded-lg"
            data-index={i}
            data-has-image={resolvedItems[i].hasImage ? 'true' : undefined}
            aria-describedby={`item-desc-${i}`}
          >
            <div class="flex items-baseline">
              <span class="text-xl lg:text-2xl font-geist font-bold uppercase text-eos-accent group-hover:text-eos-base transition-colors duration-200">
                {item.label}
              </span>
            </div>
            {item.description && (
              <div class="overflow-hidden max-h-0 group-hover:max-h-40 transition-all duration-500 ease-in-out">
                <p id={`item-desc-${i}`} class="text-eos-text text-sm mt-2 max-w-prose group-hover:text-eos-base/90">
                  {item.description}
                </p>
              </div>
            )}
            <!-- Mobile: static image below each item (only if image exists) -->
            {resolvedItems[i].hasImage && (
              <div class="mt-4 lg:hidden">
                {resolvedItems[i].optimizedImage ? (
                  <Image
                    src={resolvedItems[i].optimizedImage!}
                    alt={item.imageAlt ?? item.label}
                    width={MOBILE_WIDTH}
                    height={MOBILE_HEIGHT}
                    format="webp"
                    loading="lazy"
                    class="w-full h-48 object-cover rounded-lg img-greyscale"
                  />
                ) : (
                  <img
                    src={item.image}
                    alt={item.imageAlt ?? item.label}
                    width={MOBILE_WIDTH}
                    height={MOBILE_HEIGHT}
                    loading="lazy"
                    class="w-full h-48 object-cover rounded-lg img-greyscale"
                  />
                )}
              </div>
            )}
          </li>
        ))}
      </ul>

      <!-- RIGHT: Floating image panel (desktop only, only if at least one item has an image) -->
      {hasAnyImage && (
        <div class="hidden lg:block sticky top-24 w-[42%] flex-shrink-0" aria-hidden="true">
          <div class="relative aspect-square overflow-hidden rounded-xl bg-eos-subtle">
            {itemsWithImages.map((item, imgIdx) => (
              <div
                class="hover-image absolute inset-0 w-full h-full object-cover img-greyscale"
                data-index={items.indexOf(item)}
                data-img-index={imgIdx}
                style={imgIdx === 0 ? "opacity: 1;" : "opacity: 0;"}
              >
                {item.optimizedImage ? (
                  <Image
                    src={item.optimizedImage}
                    alt={item.imageAlt ?? item.label}
                    width={DESKTOP_WIDTH}
                    height={DESKTOP_HEIGHT}
                    format="webp"
                    loading={imgIdx === 0 ? 'eager' : 'lazy'}
                    fetchpriority={imgIdx === 0 ? 'high' : undefined}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <img
                    src={item.image}
                    alt={item.imageAlt ?? item.label}
                    width={DESKTOP_WIDTH}
                    height={DESKTOP_HEIGHT}
                    loading={imgIdx === 0 ? 'eager' : 'lazy'}
                    class="w-full h-full object-cover"
                  />
                )}
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  function initInteractiveList() {
    const sections = document.querySelectorAll('[data-interactive-list]');

    sections.forEach((section) => {
      const items = section.querySelectorAll('.interactive-list-item');
      const images = section.querySelectorAll('.hover-image');

      if (images.length === 0) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isTouch = window.matchMedia('(hover: none)').matches;

      // Show first image by default
      gsap.set(images, { opacity: 0 });
      gsap.set(images[0], { opacity: 1 });

      if (reducedMotion || isTouch) return;

      items.forEach((item) => {
        const itemIndex = Number(item.getAttribute('data-index'));
        // Find the hover-image whose data-index matches this list item
        const matchingImage = section.querySelector(`.hover-image[data-index="${itemIndex}"]`);

        item.addEventListener('mouseenter', () => {
          if (!matchingImage) return; // text-only item, no image to show
          gsap.set(images, { opacity: 0 });
          gsap.fromTo(
            matchingImage,
            { opacity: 0, y: 12 },
            { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }
          );
        });
      });
    });
  }

  initInteractiveList();
  document.addEventListener('astro:after-swap', initInteractiveList);
</script>
